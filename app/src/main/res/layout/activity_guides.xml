<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ACTIVITIES.GuidesActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <ImageView
            android:id="@+id/ivBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/leaves_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/bgScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#26000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="#1B5E20"
            app:title=""
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open menu"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:layout_constraintTop_toTopOf="@id/topBar"
            app:layout_constraintBottom_toBottomOf="@id/topBar"
            app:layout_constraintEnd_toEndOf="@id/topBar"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:id="@+id/layoutGuidesContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="22dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guides"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold|italic" />

            <View
                android:layout_width="64dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="#FFFFFF" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearchGuide"
                android:layout_width="356dp"
                android:layout_height="190dp"
                app:cardBackgroundColor="#EFFFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvSearchLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Search guides"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSearchInput"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#F8FFFFFF"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#C9D6CC"
                        app:strokeWidth="1dp">

                        <EditText
                            android:id="@+id/etGuideTitleSearch"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:hint="guide title"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="#111827"
                            android:textColorHint="#6B7280" />
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearchGuides"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#1B5E20"
                        android:text="Search"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGuidesList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#EFFFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGuides"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="24dp"
                    android:scrollbars="vertical"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_guide" />
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCreatorActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="#EFFFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnalytics"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Analytics"
                        android:textAllCaps="false"
                        android:textColor="#1B5E20"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:strokeColor="#1B5E20"
                        app:strokeWidth="1dp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateGuide"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:backgroundTint="#1B5E20"
                        android:text="Create guide"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingTop="22dp"
        android:paddingBottom="22dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/tvDrawerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#1B5E20"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp" />

        <TextView
            android:id="@+id/navMyPlants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My plants"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calender"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navGuides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guides"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textSize="18sp"
            android:textColor="#D32F2F"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>