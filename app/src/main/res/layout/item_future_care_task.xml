<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FCFDFC"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#D9E6DA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFutureTaskType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Repot"
                android:textColor="#1B5E20"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Repot" />

            <TextView
                android:id="@+id/tvFutureTaskEveryDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F3E9"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="Every 365 days"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Every 365 days" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNextDueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next due:"
                android:textColor="#6B7280"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFutureTaskDue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="14/01/2027"
                android:textColor="#374151"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="14/01/2027" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditFutureTask"
            android:layout_width="160dp"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:text="Edit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1B5E20"
            app:cornerRadius="16dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>