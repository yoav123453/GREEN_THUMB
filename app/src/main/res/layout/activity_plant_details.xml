<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ACTIVITIES.PlantDetailsActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <ImageView
            android:id="@+id/ivBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/leaves_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/bgScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#26000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="#1B5E20"
            app:title=""
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Open menu"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:layout_constraintTop_toTopOf="@id/topBar"
            app:layout_constraintBottom_toBottomOf="@id/topBar"
            app:layout_constraintEnd_toEndOf="@id/topBar"
            app:tint="#FFFFFF" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlantDetails"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="#EFFFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvScreenTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Plant details"
                        android:textAlignment="center"
                        android:textColor="#1B5E20"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlantNickname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="&quot;Monstera in living room&quot;"
                        android:textAlignment="center"
                        android:textColor="#374151"
                        android:textSize="18sp"
                        android:textStyle="italic" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:background="#1B5E20" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <TextView
                        android:id="@+id/tvPlantInfoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Plant information"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="10dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPlantInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#F8FBF8"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#D9E6DA"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="110dp"
                                    android:layout_height="wrap_content"
                                    android:text="Species:"
                                    android:textColor="#1B5E20"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvSpeciesValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Monstera deliciosa"
                                    android:textColor="#374151"
                                    android:textSize="15sp"
                                    tools:text="Monstera deliciosa" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="110dp"
                                    android:layout_height="wrap_content"
                                    android:text="Location:"
                                    android:textColor="#1B5E20"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvLocationValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Living room"
                                    android:textColor="#374151"
                                    android:textSize="15sp"
                                    tools:text="Living room" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="110dp"
                                    android:layout_height="wrap_content"
                                    android:text="Light:"
                                    android:textColor="#1B5E20"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvLightValue"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Medium"
                                    android:textColor="#374151"
                                    android:textSize="15sp"
                                    tools:text="Medium" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="10dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"/>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <TextView
                        android:id="@+id/tvUpcomingTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Upcoming care"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUpcomingSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Only close upcoming tasks are shown here"
                        android:textColor="#6B7280"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvUpcomingTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:paddingBottom="4dp"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_upcoming_task" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="16dp" />

                    <TextView
                        android:id="@+id/tvFutureTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Future care plan"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFutureSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Long-term scheduled care is shown here"
                        android:textColor="#6B7280"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFutureTasks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:paddingBottom="4dp"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_future_care_task" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="18dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHistory"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="History"
                            android:textAllCaps="false"
                            android:textColor="#1B5E20"
                            android:textStyle="bold"
                            app:cornerRadius="16dp"
                            app:strokeColor="#1B5E20"
                            app:strokeWidth="1dp" />

                        <View
                            android:layout_width="12dp"
                            android:layout_height="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBack"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:backgroundTint="#1B5E20"
                            android:text="Back"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/drawerMenu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingTop="22dp"
        android:paddingBottom="22dp"
        android:elevation="12dp">

        <TextView
            android:id="@+id/tvDrawerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#1B5E20"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp" />

        <TextView
            android:id="@+id/navMyPlants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My plants"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calender"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navGuides"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guides"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AI"
            android:textSize="18sp"
            android:textColor="#1F2937"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/navLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textSize="18sp"
            android:textColor="#D32F2F"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>